{
  "id": "agent-loop-grasp",
  "concept": {
    "claim": "Reliability multiplies across steps; a check after every step moves the curve, at a cost.",
    "claimId": "agent-loop.compounding",
    "audience": "manager",
    "level": "grasp"
  },
  "params": { "N": 500, "k": 20, "p": 0.95, "c": 0.8, "retry": 1, "seed": 1 },
  "waivers": [
    { "law": "MAX", "reason": "INTERVIEW F1: the brief asks for Trace → ensemble → twins → truth → cost → honesty → transfer at Grasp; that is five content structures (CF, PCR, ENS, TW, TRF) against the map's [inf] budget of four. Kept on purpose as the proof graph; Q-M2 asks Manu which beat to drop." }
  ],
  "nodes": [
    { "id": "engine",   "module": "agentLoop" },
    { "id": "trace",    "module": "traceOpener", "in": { "ens": "engine.ens" } },
    { "id": "camTrace", "module": "frameFocus",  "in": { "focus": "trace.focus" }, "at": "trace.start", "params": { "margin": 1.3, "drift": 1.03, "screenAt": [560, 285] } },
    { "id": "fade",     "module": "concretenessFade", "in": { "trace": "trace.trace", "ens": "engine.ens" } },
    { "id": "camPull",  "module": "pullBack",    "in": { "focus": "trace.focus" }, "at": "fade.start", "params": { "margin": 1.3, "dur": 5.6, "hold": 0.8, "screenAt": [560, 285] } },
    { "id": "guess",    "module": "predictCommitReveal", "in": { "ens": "engine.ens" },
      "params": { "key": "guess", "world": "off", "sample": 350,
                  "label": "Runs of 500 that finish all 20 steps, no check",
                  "caption": "Your call first: 20 steps, each right 95 % of the time. How many of 500 finish?" } },
    { "id": "ens",      "module": "ensembleRun", "in": { "ens": "engine.ens", "arr": "fade.arr", "run": "trace.run" }, "params": { "world": "off", "stepDur": 0.5 } },
    { "id": "truth",    "module": "truthUnderEvidence", "in": { "ens": "engine.ens", "arr": "ens.arr", "commit": "guess.commit" }, "params": { "world": "off" } },
    { "id": "twins",    "module": "contrastingTwins", "in": { "ens": "engine.ens", "arr": "truth.arr" } },
    { "id": "cost",     "module": "costOfCheck", "in": { "ens": "engine.ens", "arr": "twins.arr" } },
    { "id": "caveat",   "module": "correlatedCaveat", "in": { "ens": "engine.ens", "arr": "twins.arr" }, "params": { "sStar": 9, "rho": 0.3 } },
    { "id": "transfer", "module": "transferQuestion",
      "params": { "key": "transfer", "kFar": 14, "pFar": 0.97, "NFar": 100, "sample": 80, "label": "Claims of 100 that clear all 14 sign-offs" } }
  ]
}
