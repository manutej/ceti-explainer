   "value": 18,
   "formula": "(function(){function mb(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;}}var P=[],i,j,s,k,y,x;for(i=0;i<popN;i++)P.push(i<popYes?1:0);var r=mb(popSeed);for(i=popN-1;i>0;i--){j=Math.floor(r()*(i+1));x=P[i];P[i]=P[j];P[j]=x;}function run(seed,n){var q=mb(seed),o=[];for(s=0;s<nSurveys;s++){y=0;for(k=0;k<n;k++)y+=P[Math.floor(q()*popN)];o.push(y);}return o;}return {s30:run(seed30,n30),s1000:run(seed1000,n1000)};})().s30[0]",
