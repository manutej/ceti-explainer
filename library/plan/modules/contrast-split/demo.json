      "p": 0.07
     },
     {
      "id": "usd",
      "label": "usd",
      "p": 0.05
     },
     {
      "id": "MXN",
      "label": "MXN",
      "p": 0.04
     },
     {
      "id": "quote",
      "label": "\"",
      "p": 0.03
     }
