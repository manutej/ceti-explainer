   "modules": [
    {
     "use": "contrast-split",
     "head": {
      "eyebrow": "CONTRAST-SPLIT · CONSTRAINED DECODING",
      "title": "Same odds, two schemas",
      "chapter": "Two schemas"
     },
     "params": {
      "vary": {
       "param": "keep",
       "b": "@example.keepB",
       "tagA": "SCHEMA A · USD US EUR MXN",
       "tagB": "SCHEMA B · USD EUR"
      },
      "read": {
       "fn": "answer",
       "args": [
        true
       ]
      },
      "scale": 100,
      "unit": " %",
      "box": {
       "x0": 50,
       "y0": 110,
       "x1": 930,
       "y1": 470
      },
      "top": 160,
      "align": {
       "at": {
        "x": 250,
        "y": 293
       },
       "line": "same model, same odds"
      },
      "differ": {
       "at": {
        "x": 893,
        "y": 158
       },
       "w": 70,
       "h": 34,
       "line": "one change, the kept set: USD {left} or {right}"
      },
      "principle": {
       "term": "the kept set is the denominator",
       "line": "p′ = p ÷ Σ kept"
      }
     },
     "inner": {
      "use": "mass-reseat",
      "params": {
       "variant": "renormalize",
       "N": "@example.marks",
       "u": "@example.draw",
       "focus": "USD",
       "bins": "@example.bins",
       "keep": "@example.keepA",
       "means": "each mark is 1/1,000 of the probability mass",
       "foot": {
        "queue": "each mark is 1/1,000 of the model’s odds · illustrative logits",
        "close": "the schema closes {dropped} tracks · together they held {droppedPct}",
        "reseat": "their marks ride back through the junction to the {kept} open tracks",
        "count": "p′ = p ÷ {mass} · ratios kept"
       },
       "principle": {
        "term": "renormalise",
        "line": "p′ = p ÷ Σ kept"
       },
       "control": {
        "label": "Constrain",
        "question": "Mask off: which token does the same draw take?",
        "on": "mask on",
        "off": "mask off"
       }
      }
     },
     "captions": {
      "clone": "Split the junction in two. Same model, same odds, same seed.",
      "flip": "Change one thing on the right: a stricter schema.",
      "a.close": "Each schema closes its own tracks.",
      "a.reseat": "The closed weight re-seats on what each schema keeps.",
      "a.count": "USD: 0.677 on the left, 0.857 on the right.",
      "a.hold": "Same odds, different denominators.",
      "a.name": "Each kept p is divided by its own kept mass.",
      "align": "What is the same: the model and its odds.",
      "differ": "What differs: only the kept set.",
      "name": "The kept set is the denominator."
     }
    }
   ]
