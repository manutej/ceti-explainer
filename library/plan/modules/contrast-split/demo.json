    "eyebrow": "Explainer modules · contrast-split · 1 of 2",
    "titleHTML": "Same odds, <em>two</em> schemas",
    "lede": "One junction, one seed, two schemas: the left keeps four currencies, the right keeps two. Only the kept set differs, and USD’s share follows it.",
    "synthTitle": "What the combinator carries",
    "synthesis": "Both halves are the same module with exactly one parameter changed (audited). The flip is a continuous wipe over identical marks; the mirror control swaps the halves and no counted number changes.",
    "sources": [
     [
      "SB M3",
      "films/typesafe — the switchyard throat",
      "../../../films/typesafe/STORYBOARD.md"
     ],
     [
      "S2/S3",
      "Outlines · XGrammar — masks precomputed per grammar state",
      "https://arxiv.org/abs/2411.15100"
     ]
    ]
   },
   "type": {
    "primary": "T2",
    "secondary": "T5"
   },
   "roles": {
