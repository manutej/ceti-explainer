# Build outputs: rebuilt from sources, never committed (the built films live in a separate films repo).
**/build/
**/out/*
!**/out/*.json
**/_npm/
node_modules/
__pycache__/
*.pyc
*.mp4
*.wav
*.srt
*.artifact.html
scratch/
renders/
.cetix-cache/
.DS_Store
__MACOSX/

# Built pages (<id>.html). Hand-authored pages and fixtures stay tracked.
*.html
!notebooks/*.html
!notebooks/**/*.html
!tests/fixtures/**
!skills/**/*.template.html
!skills/ceti-explainer/reference/longform/*.html

# factory kit shell is a template, not a built page
!factory/kit/shell.html
# stills written by probes and gates
factory/**/shots/

# built standalone pages are always kept, so the source can be refactored against them (DECISIONS D10)
!**/build/*.html

# arsenal stills: keep only the contact sheet and report
arsenal/**/shots/*
!arsenal/**/shots/contact.png
!arsenal/**/shots/report.json

# kit2 proof scratch
factory/kit2/proof/stills/
factory/kit2/proof/matrix.log

# gate output regenerated by proofs
chromes/*/out/

# frame strips are regenerated by factory/tools/frames.mjs; keep only the index
factory/**/frames/*
!factory/**/frames/frames.json
